  {
   "name": "Pseudocode: ggT nach Euklid",
   "desc": "WHILE mit IF … ELSE: der klassische Algorithmus von Euklid mit Subtraktion. Ergebnis für 84 und 36: 12.",
   "mode": "cpu",
   "cpu": {
    "hl": {
     "src": "// Größter gemeinsamer Teiler (Euklid)\na := 84\nb := 36\nWHILE a <> b DO\n  IF a > b THEN\n    a := a - b\n  ELSE\n    b := b - a\n  END IF\nEND WHILE\nOUTPUT a          // 12\n",
     "opt": true
    }
   }
  },
  {
   "name": "Pseudocode: Primzahlen",
   "desc": "Verschachtelte Schleifen, MOD und eine logische Verknüpfung mit AND. Gibt alle Primzahlen bis 60 aus. Mit hoher Geschwindigkeit laufen lassen!",
   "mode": "cpu",
   "cpu": {
    "hl": {
     "src": "// Primzahlen bis 60\nFOR n := 2 TO 60\n  prim := TRUE\n  t := 2\n  WHILE t * t <= n AND prim DO\n    IF n MOD t = 0 THEN\n      prim := FALSE\n    END IF\n    t := t + 1\n  END WHILE\n  IF prim THEN\n    OUTPUT n\n  END IF\nEND FOR\n",
     "opt": true
    }
   }
  },
  {
   "name": "Pseudocode: Fibonacci",
   "desc": "REPEAT … UNTIL: Die Schleife endet, wenn die nächste Zahl wegen des 8-Bit-Überlaufs kleiner wird (nach 233).",
   "mode": "cpu",
   "cpu": {
    "hl": {
     "src": "// Fibonacci-Zahlen bis zum Überlauf\na := 0\nb := 1\nREPEAT\n  OUTPUT b\n  c := a + b\n  a := b\n  b := c\nUNTIL b < a       // Überlauf: die neue Zahl ist kleiner\n",
     "opt": true
    }
   }
  },
  {
   "name": "Pseudocode: Bubblesort",
   "desc": "Sortiert ein Feld (ARRAY). Weil der Rechner keine indirekte Adressierung kennt, schreibt das Programm die Adresse von z[j] zur Laufzeit in seine eigenen Befehle – Von-Neumann in Reinform.",
   "mode": "cpu",
   "cpu": {
    "hl": {
     "src": "// Bubblesort: sortiert fünf Zahlen\nARRAY z := [42, 7, 99, 13, 58]\nFOR i := 0 TO 3\n  FOR j := 0 TO 3 - i\n    IF z[j] > z[j + 1] THEN\n      tmp := z[j]\n      z[j] := z[j + 1]\n      z[j + 1] := tmp\n    END IF\n  END FOR\nEND FOR\nFOR i := 0 TO 4\n  OUTPUT z[i]\nEND FOR\n",
     "opt": true
    }
   }
  },
